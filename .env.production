# Production Environment Variables
# Frontend API URL - Point to your backend Railway URL
VITE_API_URL=https://your-backend-railway-url.up.railway.app/api

# Socket.IO URL - Must point to your backend Railway URL (NOT frontend URL)
VITE_SOCKET_URL=https://your-backend-railway-url.up.railway.app

# Backend CORS Configuration (for Socket.IO and API)
NODE_ENV=production
FRONTEND_URL=https://yourdomain.com
CLIENT_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
PUBLIC_BASE_URL=https://api.yourdomain.com

# Socket.IO Configuration
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000